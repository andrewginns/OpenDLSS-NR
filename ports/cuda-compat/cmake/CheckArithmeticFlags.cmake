function(nr_check_arithmetic_flags)
  set(variables CMAKE_CUDA_FLAGS CMAKE_CXX_FLAGS)
  foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
    string(TOUPPER "${config}" config)
    list(APPEND variables CMAKE_CUDA_FLAGS_${config} CMAKE_CXX_FLAGS_${config})
  endforeach()
  foreach(variable IN LISTS variables)
    separate_arguments(arguments UNIX_COMMAND "${${variable}}")
    set(previous "")
    foreach(argument IN LISTS arguments)
      if(argument MATCHES "^(--compiler-options|-Xcompiler)=(.*)$")
        string(REPLACE "," ";" forwarded "${CMAKE_MATCH_2}")
        foreach(option IN LISTS forwarded)
          if(option MATCHES "^(-ffast-math|/fp:fast)$")
            message(FATAL_ERROR "${variable}: unsafe flags alter the compatibility arithmetic")
          endif()
        endforeach()
      endif()
      if(argument MATCHES "^(--?use_fast_math|-ffast-math|/fp:fast)$" OR
         argument MATCHES "^--?(ftz=true|prec-(div|sqrt)=false)$" OR
         (previous MATCHES "^--?ftz$" AND argument STREQUAL "true") OR
         (previous MATCHES "^--?prec-(div|sqrt)$" AND argument STREQUAL "false"))
        message(FATAL_ERROR "${variable}: unsafe flags alter the compatibility arithmetic")
      endif()
      set(previous "${argument}")
    endforeach()
  endforeach()
endfunction()
